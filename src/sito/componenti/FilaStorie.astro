---
// La fila delle storie sotto l'header: si vede solo sul telefono, fino a 767 px.
// Da 768 px in su la sezione è nascosta (`display: none`), quindi non c'è
// nemmeno per i lettori di schermo. Sul computer e sul tablet le foto stanno
// nell'apertura e nel diario. Le storie (collection `storie`, nell'ordine fisso)
// le passa la pagina.
import CerchioStoria from './CerchioStoria.astro';
import type { Storia } from './dati';

interface Props {
  storie: Storia[];
}

const { storie } = Astro.props;
---

<section class="storie" aria-label="Storie dal negozio">
  <div class="dentro">
    <ul class="fila" role="list">
      {
        storie.map((storia) => (
          <li>
            <CerchioStoria storia={storia} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .storie {
    background: var(--bianco);
    box-shadow: 0 1px 0 var(--linea);
  }

  @media (width > 767px) {
    .storie {
      display: none;
    }
  }

  .dentro {
    display: flex;
    align-items: center;
    max-width: var(--larghezza);
    margin: 0 auto;
    padding: 6px 0;
  }

  .fila {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    gap: 12px;
    margin: 0;
    /* Spazio attorno ai cerchi: l'anello e il focus non vengono tagliati. */
    padding: 8px 16px 10px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .fila::-webkit-scrollbar {
    display: none;
  }
</style>
