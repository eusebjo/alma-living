---
// Le due foto di una scheda, una sopra l'altra, e l'interruttore che passa
// dall'una all'altra (protocollo "Interruttore" dello script comune). Il secondo
// scatto è sempre nell'HTML, a opacità 0: si vede con `aria-pressed="true"`
// dell'interruttore o quando il contenitore imposta `--secondo: 1` (sul computer,
// il passaggio del mouse sulla scheda). Le due foto hanno ognuna il suo testo
// alternativo: il CSS non può togliere dall'albero dell'accessibilità ciò che
// mostra o nasconde, quindi chi usa un lettore di schermo sente tutte e due.
//
// Dal contenitore legge due proprietà CSS:
// - `--secondo`: 0 o 1, quale scatto si vede (vale 1 con l'interruttore premuto);
// - `--interruttore-basso`: la distanza dell'interruttore dal fondo (16px se manca).
// E, per l'ingrandimento, `--zoom` (il passaggio del mouse) e `--scala` (la scala
// del dettaglio, scritta da `Foto.astro`).
//
// Né `.due` né i suoi contenitori creano un contesto di sovrapposizione (niente
// `z-index`, `isolation`, `transform`, `filter`): altrimenti l'interruttore
// resterebbe sotto il link che copre la scheda.
import Foto from './Foto.astro';
import type { ScattoArticolo } from './dati';

interface Props {
  scatti: readonly [ScattoArticolo, ScattoArticolo];
  /** Il nome dell'articolo: dà il nome all'interruttore. */
  nome: string;
  larghezze: number[];
  sizes: string;
}

const { scatti, nome, larghezze, sizes } = Astro.props;
---

<div class="due">
  <Foto scatto={scatti[0]} larghezze={larghezze} sizes={sizes} class="scatto" />
  <Foto scatto={scatti[1]} larghezze={larghezze} sizes={sizes} class="scatto secondo" />
  <button
    type="button"
    class="interruttore"
    data-interruttore
    aria-pressed="false"
    aria-label={`Seconda foto: ${nome}`}
  >
    <span></span><span></span>
  </button>
</div>

<style>
  .due {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .due :global(.scatto) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(calc(var(--scala, 1) * var(--zoom, 1)));
    transition:
      opacity 600ms ease,
      transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .due :global(.secondo) {
    opacity: var(--secondo, 0);
  }

  .due:has(> .interruttore[aria-pressed='true']) {
    --secondo: 1;
  }

  /* --- L'interruttore: due pallini, quello dello scatto mostrato è lungo e bianco.
     Seguono `--secondo`, quindi anche il passaggio del mouse. --- */
  .interruttore {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: var(--interruttore-basso, 16px);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 56px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--pillola);
    background: none;
  }

  .interruttore span {
    display: block;
    height: 7px;
    border-radius: var(--pillola);
    box-shadow: var(--ombra-punto);
    transition:
      width 300ms ease,
      background-color 300ms ease;
  }

  .interruttore span:first-child {
    width: calc(7px + 11px * (1 - var(--secondo, 0)));
    background-color: color-mix(
      in srgb,
      var(--bianco) calc((1 - var(--secondo, 0)) * 100%),
      var(--punto-spento)
    );
  }

  .interruttore span:last-child {
    width: calc(7px + 11px * var(--secondo, 0));
    background-color: color-mix(
      in srgb,
      var(--bianco) calc(var(--secondo, 0) * 100%),
      var(--punto-spento)
    );
  }

  /* Sulla foto: un anello bianco dentro e uno salvia fuori, visibili su ogni foto. */
  .due > .interruttore:focus-visible {
    outline: 2px solid var(--bianco);
    outline-offset: 0;
    box-shadow: 0 0 0 4px var(--salvia-scura);
  }

  /* Senza JavaScript il pulsante non farebbe nulla. */
  @media (scripting: none) {
    .interruttore {
      display: none;
    }
  }
</style>
