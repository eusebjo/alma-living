---
import { getEntry } from 'astro:content';
import { absoluteUrl, getSiteConfig } from '../config/site';
import { buildStoreJsonLd, serializeJsonLd } from '../lib/schemaOrg';

interface Props {
  title: string;
  description: string;
  /** Pagina da tenere sempre fuori dai motori di ricerca, anche a sito lanciato. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const { siteUrl, indexable } = getSiteConfig(process.env);
const canonical = absoluteUrl(siteUrl, Astro.url.pathname);

const negozioEntry = await getEntry('negozio', 'negozio');
if (!negozioEntry) {
  throw new Error('Manca src/content/negozio/negozio.json (voce "negozio").');
}
const negozio = negozioEntry.data;

// I dati strutturati vanno pubblicati solo a sito lanciato, su produzione:
// prima descriverebbero un negozio che sul web non c'è ancora. Una pagina con
// `noindex` non ne ha mai.
const jsonLd =
  indexable && !noindex
    ? serializeJsonLd(buildStoreJsonLd(negozio, siteUrl))
    : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{(noindex || !indexable) && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="it_IT" />
<meta property="og:site_name" content={negozio.nome} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
