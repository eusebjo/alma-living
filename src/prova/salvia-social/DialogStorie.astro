  }

  /* --- Telefono ruotato (o finestra bassa): la scheda può non starci, quindi
     scorre, dentro un riquadro che comincia sotto la testata (così nulla le
     passa sotto). Qui un trascinamento sulla scheda la fa scorrere e non la
     chiude: restano "Torna alla storia", Esc e la X. --- */
  @media (max-height: 500px) {
