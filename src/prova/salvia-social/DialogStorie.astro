  /* --- A scheda aperta, sotto di lei frase, "altro", pillola, frecce e pausa non
     ci sono, né per il tab né per i lettori di schermo: la storia è già ferma e
     si torna con "Torna alla storia" (o Esc). Restano barre, testata e X. --- */
  .storie[data-storia-invito-aperto] :is(.frase, .altro, .fascia, .freccia, .pausa) {
    visibility: hidden;
  }

  /* --- Tenendo premuto: testata, comandi, frase, "altro", pillola, frecce e il
     velo della frase spariscono in dissolvenza; restano la foto e le barre (con
     il loro velo). Dopo la regola della frase aperta, che ha lo stesso peso. --- */
  .storie[data-storia-nascosta] :is(.testa, .comandi, .frase, .altro, .fascia, .freccia),
  .storie[data-storia-nascosta] .foto::before,
