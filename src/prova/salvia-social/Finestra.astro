---
// La finestra sullo scaffale: una fascia salvia chiara, larga quanto la riga della
// griglia della selezione, con la foto a sinistra (il 40%) e a destra occhiello,
// titolo, frase e il pulsante che scrive su WhatsApp. Serve due volte in
// `Selezione.astro`: "Non lo trovi qui?" con lo scaffale, "Il mare torna in
// primavera" con il filtro Mare. Dove sta nella griglia lo decide `Selezione.astro`.
//
// Fino a 767 px la finestra è bassa (200 px): la frase non c'è e il pulsante dice
// solo `azione` ("Scrivici", "Chiedi"); `resto` (" su WhatsApp") resta per i
// lettori di schermo, così il nome del link è sempre completo. Da 768 px c'è tutto.
// Sul computer con il mouse (`(hover: hover) and (width > 1023px)`) il passaggio del
// mouse ingrandisce appena la foto. Le misure del tablet (300 px) la tavola non le
// ha: sono quelle del computer, più strette.
import Foto from './Foto.astro';
import Icona from './Icona.astro';
import type { Scatto } from './dati';

interface Props {
  scatto: Scatto;
  occhiello: string;
  titolo: string;
  /** La frase sotto il titolo: si vede da 768 px. */
  testo: string;
  /** Il link del pulsante (di solito WhatsApp con il messaggio già scritto). */
  href: string;
  /** La parte del nome del pulsante che si vede sempre: "Scrivici". */
  azione: string;
  /** Il resto del nome, solo per i lettori di schermo fino a 767 px: " su WhatsApp". */
  resto: string;
}

const { scatto, occhiello, titolo, testo, href, azione, resto } = Astro.props;
---

<div class="finestra">
  <div class="foto">
    <Foto scatto={scatto} larghezze={[300, 450, 600]} sizes="(min-width: 1024px) 532px, 40vw" />
  </div>
  <div class="testo">
    <p class="occhiello">{occhiello}</p>
    <h3>{titolo}</h3>
    <p class="frase">{testo}</p>
    <a class="azione" href={href}>
      <Icona nome="whatsapp" misura={18} /><span class="parole">{azione}<span class="lungo">{resto}</span></span>
    </a>
  </div>
</div>

<style>
  /* --- Telefono (fino a 767 px) --- */
  .finestra {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    min-height: 200px;
    overflow: hidden;
    border-radius: var(--raggio-telefono);
    background: var(--salvia-chiara);
  }

  .foto {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--sabbia);
  }

  .foto :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .testo {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 16px 14px 16px 16px;
  }

  .occhiello {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--salvia-scura);
  }

  h3 {
    margin: 6px 0 0;
    max-width: 15em;
    font-family: var(--titoli);
    font-size: 19px;
    font-weight: 400;
    line-height: 1.12;
    text-wrap: balance;
  }

  .frase {
    display: none;
    margin: 14px 0 0;
    max-width: 30em;
    font-size: 17px;
    line-height: 1.55;
    color: var(--verde-notte);
    text-wrap: pretty;
  }

  .azione {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 14px;
    padding: 0 16px 0 14px;
    border-radius: var(--pillola);
    background: var(--salvia-scura);
    color: var(--bianco);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 200ms ease;
  }

  .azione:hover {
    background: var(--salvia-scura-sopra);
  }

  /* Fino a 767 px nascosto alla vista, ma letto: come `.solo-lettori` (`tema.css`). */
  @media (max-width: 767px) {
    .lungo {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
  }

  /* --- Tablet e computer (da 768 px): i punti di rottura sono i complementi
     esatti di `LIMITI_SELEZIONE` (vedi `Selezione.astro`) --- */
  @media (width > 767px) {
    .finestra {
      min-height: 300px;
      border-radius: var(--raggio);
    }

    .testo {
      padding: 32px 40px;
    }

    .occhiello {
      font-size: 12px;
    }

    h3 {
      margin-top: 12px;
      font-size: 30px;
    }

    .frase {
      display: block;
    }

    .azione {
      min-height: 50px;
      margin-top: 28px;
      padding: 0 26px 0 22px;
      font-size: 15px;
    }
  }

  /* --- Computer (da 1024 px) --- */
  @media (width > 1023px) {
    .finestra {
      min-height: 360px;
    }

    .testo {
      padding: 48px 64px;
    }

    .occhiello {
      font-size: 13px;
    }

    h3 {
      font-size: 40px;
    }
  }

  @media (hover: hover) and (width > 1023px) {
    .finestra:hover .foto :global(img) {
      transform: scale(1.04);
    }
  }
</style>
