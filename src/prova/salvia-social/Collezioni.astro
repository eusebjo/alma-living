---
// Le collezioni per stanza: quattro riquadri di misure diverse (sul computer
// una griglia a 12 colonne, sul telefono a 2) e le pillole "In negozio trovi
// anche". Portano alla selezione.
import Foto from './Foto.astro';
import Icona from './Icona.astro';
import { altreCollezioni, collezioni } from './dati';

// Quanto è largo ogni riquadro, nell'ordine di `collezioni` (vedi la griglia sotto).
const MISURE = [
  '(min-width: 960px) 40vw, 50vw',
  '(min-width: 960px) 56vw, 50vw',
  '(min-width: 960px) 32vw, 50vw',
  '(min-width: 960px) 24vw, 100vw',
];
---

<section id="collezioni" class="collezioni" aria-labelledby="collezioni-titolo">
  <div class="intestazione">
    <div class="titoli">
      <p class="occhiello">Collezioni</p>
      <h2 id="collezioni-titolo">Per ogni stanza della casa</h2>
    </div>
    <p class="presentazione">
      Dal letto alla tavola, quello che trovi adesso sugli scaffali di Via Ricasoli. Scegli una stanza
      e ti mostriamo la selezione.
    </p>
  </div>

  <ul class="riquadri" role="list">
    {
      collezioni.map((stanza, i) => (
        <li class="riquadro">
          <a class="stanza" href="#selezione">
            <Foto
              scatto={stanza}
              larghezze={[300, 450, 600, 800, 1000]}
              sizes={MISURE[i] ?? '50vw'}
            />
            <span class="etichetta">
              <span class="testo">
                <span class="nome">{stanza.nome}</span>
                <span class="frase">{stanza.frase}</span>
              </span>
              <span class="freccia" aria-hidden="true">
                <Icona nome="freccia" misura={18} />
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="altre">
    <span class="altre-titolo">In negozio trovi anche</span>
    <ul class="pillole" role="list">
      {
        altreCollezioni.map((altra) => (
          <li>
            <a class="pillola" href="#selezione">
              <Foto scatto={altra} alt="" larghezze={[80]} sizes="40px" />
              {altra.nome}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .collezioni {
    max-width: var(--larghezza);
    margin: 0 auto;
    padding: var(--sezione) var(--margine) 0;
    scroll-margin-top: var(--ancora);
  }

  .intestazione {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px 48px;
  }

  .titoli {
    max-width: 640px;
  }

  .occhiello {
    margin: 0;
    font-size: var(--occhiello);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--salvia-scura);
  }

  h2 {
    margin: 12px 0 0;
    font-family: var(--titoli);
    font-size: var(--h2);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .presentazione {
    max-width: 30em;
    margin: 0;
    font-size: var(--testo-sezione);
    color: var(--grigio-testo);
    text-wrap: pretty;
  }

  /* --- Riquadri: sul telefono due colonne, il primo alto, l'ultimo largo --- */
  .riquadri {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 200px;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .riquadro:nth-child(1) {
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  .riquadro:nth-child(2) {
    grid-column: 2;
    grid-row: 1;
  }

  .riquadro:nth-child(3) {
    grid-column: 2;
    grid-row: 2;
  }

  .riquadro:nth-child(4) {
    grid-column: 1 / span 2;
    grid-row: 3;
  }

  .stanza {
    position: relative;
    display: block;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--raggio-telefono);
    background: var(--sabbia);
    color: var(--nero);
    text-decoration: none;
  }

  .stanza :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .etichetta {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 8px 8px 14px;
    border-radius: var(--raggio-piccolo);
    background: var(--bianco);
    box-shadow: var(--ombra-etichetta);
  }

  .testo {
    flex: 1 1 auto;
    min-width: 0;
  }

  .nome {
    display: block;
    font-family: var(--titoli);
    font-size: 17px;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .frase {
    display: none;
  }

  .freccia {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--bianco);
    color: var(--nero);
    box-shadow: inset 0 0 0 1px var(--bordo);
    transition:
      background-color 250ms ease,
      color 250ms ease,
      box-shadow 250ms ease;
  }

  @media (hover: hover) {
    .stanza:hover :global(img) {
      transform: scale(1.04);
    }

    .stanza:hover .freccia {
      background: var(--salvia-scura);
      color: var(--bianco);
      box-shadow: inset 0 0 0 1px var(--salvia-scura);
    }
  }

  /* --- Pillole --- */
  .altre {
    display: flex;
    align-items: center;
    gap: 10px 12px;
    margin: 16px calc(-1 * var(--margine)) 0;
    padding: 4px var(--margine) 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .altre::-webkit-scrollbar {
    display: none;
  }

  .altre-titolo {
    flex: none;
    margin-right: 6px;
    font-size: 15px;
    color: var(--grigio-testo);
  }

  .pillole {
    display: flex;
    gap: 10px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillola {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 6px 20px 6px 6px;
    border-radius: var(--pillola);
    background: var(--bianco);
    box-shadow: inset 0 0 0 1px var(--bordo);
    color: var(--nero);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .pillola :global(img) {
    display: block;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .pillola:hover {
    background: var(--latte);
    box-shadow: inset 0 0 0 1px var(--nero);
  }

  /* --- Tablet: riquadri più alti, con la frase --- */
  @media (min-width: 600px) {
    .riquadri {
      grid-auto-rows: 260px;
      gap: 16px;
    }

    .etichetta {
      left: 12px;
      right: 12px;
      bottom: 12px;
      padding: 12px 12px 12px 18px;
    }

    .nome {
      font-size: 22px;
    }

    .frase {
      display: block;
      margin-top: 4px;
      font-size: 14px;
      line-height: 1.45;
      color: var(--grigio-testo);
    }

    .freccia {
      width: 40px;
      height: 40px;
    }
  }

  /* --- Computer: griglia a 12 colonne, due righe --- */
  @media (min-width: 960px) {
    .riquadri {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: clamp(250px, 23vw, 330px);
      gap: 20px;
      margin-top: 44px;
    }

    .riquadro:nth-child(1) {
      grid-column: 1 / span 5;
      grid-row: 1 / span 2;
    }

    .riquadro:nth-child(2) {
      grid-column: 6 / span 7;
      grid-row: 1;
    }

    .riquadro:nth-child(3) {
      grid-column: 6 / span 4;
      grid-row: 2;
    }

    .riquadro:nth-child(4) {
      grid-column: 10 / span 3;
      grid-row: 2;
    }

    .stanza {
      border-radius: var(--raggio);
    }

    .etichetta {
      left: 16px;
      right: 16px;
      bottom: 16px;
      max-width: 440px;
      padding: 16px 16px 16px 22px;
      border-radius: var(--raggio-medio);
    }

    .nome {
      font-size: 24px;
    }

    .riquadro:nth-child(-n + 2) .nome {
      font-size: 28px;
    }

    .frase {
      font-size: 15px;
    }

    .freccia {
      width: 44px;
      height: 44px;
    }

    .altre {
      flex-wrap: wrap;
      margin: 24px 0 0;
      padding: 0;
      overflow: visible;
    }

    .pillole {
      flex-wrap: wrap;
    }
  }

  /* Tra 960 e 1199 px i due riquadri piccoli tengono solo il nome. */
  @media (min-width: 960px) and (max-width: 1199px) {
    .riquadro:nth-child(n + 3) .frase {
      display: none;
    }

    .riquadro:nth-child(n + 3) .etichetta {
      padding-left: 16px;
    }

    .riquadro:nth-child(n + 3) .nome {
      font-size: 21px;
    }
  }
</style>
