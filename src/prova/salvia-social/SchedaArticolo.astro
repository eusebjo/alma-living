---
// Un articolo della selezione: foto, categoria, nome, dettaglio e "Chiedi
// disponibilità", che apre sopra la scheda il messaggio WhatsApp già scritto
// (protocollo "Chiedi" dello script comune).
import type { DatiNegozio } from '../comune/negozio';
import { linkWhatsApp, messaggioDisponibilita } from '../comune/contatti';
import Foto from './Foto.astro';
import Icona from './Icona.astro';
import { categorie, type Articolo } from './dati';

interface Props {
  articolo: Articolo;
  negozio: DatiNegozio;
}

const { articolo, negozio } = Astro.props;
const categoria = categorie.find((c) => c.id === articolo.categorie[0])?.nome ?? '';
const messaggio = messaggioDisponibilita(articolo.nome);
const titolo = `articolo-${articolo.id}`;
const pannello = `chiedi-${articolo.id}`;
---

<article class="scheda" aria-labelledby={titolo}>
  <div class="foto">
    <Foto scatto={articolo} larghezze={[300, 450, 600]} sizes="(min-width: 960px) 280px, 236px" />
    {articolo.novita && <span class="novita">Novità</span>}
  </div>
  <div class="corpo">
    <p class="categoria">{categoria}</p>
    <h3 id={titolo}>{articolo.nome}</h3>
    <p class="dettaglio">{articolo.dettaglio}</p>
    <div class="piede">
      <button
        type="button"
        class="chiedi"
        data-chiedi={articolo.id}
        aria-expanded="false"
        aria-controls={pannello}
      >
        <Icona nome="whatsapp" misura={18} />Chiedi disponibilità
      </button>
    </div>
  </div>

  <div
    id={pannello}
    class="pannello"
    data-chiedi-pannello={articolo.id}
    role="group"
    aria-label={`Chiedi disponibilità: ${articolo.nome}`}
    hidden
  >
    <div class="pannello-dentro">
      <div class="pannello-testa">
        <span class="pannello-titolo">Chiedi disponibilità</span>
        <button type="button" class="chiudi" data-chiedi={articolo.id} aria-label="Chiudi">
          <Icona nome="chiudi" misura={18} />
        </button>
      </div>
      <p class="pannello-nome">{articolo.nome}</p>
      <p class="messaggio">{messaggio}</p>
      <p class="nota">Il messaggio è già scritto: puoi cambiarlo prima di inviarlo.</p>
      <div class="pannello-azioni">
        <a class="pieno" href={linkWhatsApp(negozio.whatsapp, messaggio)}>
          <Icona nome="whatsapp" misura={18} />Apri WhatsApp
        </a>
        <a class="filo" href={negozio.telefonoHref}>
          <Icona nome="telefono" misura={18} />Chiama
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .scheda {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 10px 10px 18px;
    border-radius: var(--raggio-scheda);
    background: var(--latte);
    transition:
      transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 450ms ease;
  }

  .foto {
    position: relative;
    overflow: hidden;
    border-radius: var(--raggio-medio);
    background: var(--sabbia);
  }

  .foto :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .novita {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 6px 11px;
    border-radius: var(--pillola);
    background: var(--bianco);
    color: var(--salvia-scura);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .corpo {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 0 8px;
  }

  .categoria {
    margin: 16px 0 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--salvia-scura);
  }

  h3 {
    margin: 6px 0 0;
    font-family: var(--titoli);
    font-size: 21px;
    font-weight: 400;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .dettaglio {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--grigio-testo);
  }

  .piede {
    margin-top: auto;
    padding-top: 16px;
  }

  .chiedi {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px 0 15px;
    border: 0;
    border-radius: var(--pillola);
    background: transparent;
    color: var(--nero);
    box-shadow: inset 0 0 0 1px var(--nero);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease;
  }

  .chiedi[aria-expanded='true'] {
    background: var(--salvia-scura);
    color: var(--bianco);
    box-shadow: inset 0 0 0 1px var(--salvia-scura);
  }

  @media (hover: hover) and (min-width: 960px) {
    .scheda:hover {
      transform: translateY(-6px);
      box-shadow: var(--ombra-scheda);
    }

    .scheda:hover .foto :global(img) {
      transform: scale(1.04);
    }

    .scheda:hover .chiedi {
      background: var(--salvia-scura);
      color: var(--bianco);
      box-shadow: inset 0 0 0 1px var(--salvia-scura);
    }
  }

  /* --- Il pannello sopra la scheda --- */
  .pannello {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .pannello-dentro {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 16px 18px 18px;
    overflow-y: auto;
    border-radius: var(--raggio-scheda);
    background: var(--bianco);
    box-shadow:
      inset 0 0 0 1px var(--bordo-chiaro),
      var(--ombra-pannello);
  }

  .pannello-testa {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .pannello-titolo {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--salvia-scura);
  }

  .chiudi {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--latte);
    color: var(--nero);
  }

  .chiudi:hover {
    background: var(--latte-sopra);
  }

  .pannello-nome {
    margin: 0;
    font-family: var(--titoli);
    font-size: 22px;
    line-height: 1.15;
  }

  .messaggio {
    margin: 0;
    padding: 12px 14px;
    border-radius: var(--raggio-medio) var(--raggio-medio) var(--raggio-medio) 4px;
    background: var(--salvia-chiara);
    font-size: 15px;
    line-height: 1.45;
  }

  .nota {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--grigio-testo);
  }

  .pannello-azioni {
    display: grid;
    gap: 8px;
    margin-top: auto;
  }

  .pannello-azioni a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    border-radius: var(--pillola);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    transition: background-color 200ms ease;
  }

  .pieno {
    background: var(--salvia-scura);
    color: var(--bianco);
  }

  .pieno:hover {
    background: var(--salvia-scura-sopra);
  }

  .filo {
    box-shadow: inset 0 0 0 1px var(--nero);
    color: var(--nero);
  }

  .filo:hover {
    background: var(--latte-sopra);
  }

  @media (min-width: 960px) {
    h3 {
      font-size: 23px;
    }

    .dettaglio {
      font-size: 15px;
    }
  }
</style>
