---
// Una foto di prova con `<Picture>`: AVIF e WebP alle larghezze indicate (Astro
// scarta da sé quelle oltre l'originale), taglio centrato su `scatto.posizione`.
// Le misure e il taglio (`object-fit`) li decide il contenitore. Uno scatto con
// `ingrandimento` (il secondo scatto di una scheda, un dettaglio) porta anche il
// punto di ingrandimento e la scala (`--scala`): chi lo mostra le usa nel suo CSS.
import { Picture } from 'astro:assets';
import { foto } from '../comune/foto';
import type { Scatto, ScattoArticolo } from './dati';

interface Props {
  scatto: Scatto | ScattoArticolo;
  /** Larghezze in px da generare, per `srcset`. */
  larghezze: number[];
  /** Attributo `sizes`: quanto è larga la foto nella pagina. */
  sizes: string;
  /** La foto principale della pagina: subito e con priorità alta. */
  principale?: boolean;
  /** Testo alternativo diverso da quello della foto (vuoto se decorativa). */
  alt?: string;
  class?: string;
}

const { scatto, larghezze, sizes, principale = false, alt = scatto.alt, class: classe } = Astro.props;

const ingrandimento = 'ingrandimento' in scatto ? scatto.ingrandimento : undefined;
const stile =
  `object-position: ${scatto.posizione}` +
  (ingrandimento
    ? `; transform-origin: ${ingrandimento.origine}; --scala: ${ingrandimento.scala}`
    : '');
---

<Picture
  src={foto(scatto.foto)}
  formats={['avif', 'webp']}
  widths={larghezze}
  sizes={sizes}
  alt={alt}
  loading={principale ? 'eager' : 'lazy'}
  fetchpriority={principale ? 'high' : undefined}
  class={classe}
  style={stile}
/>
