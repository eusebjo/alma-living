---
// Le icone a tratto della tavola (24 x 24, tratto 1,6). Sempre decorative: il
// nome del controllo è nel testo o in `aria-label` del pulsante che le contiene.
interface Props {
  nome: keyof typeof TRATTI;
  /** Lato in px (la tavola usa 15-22). */
  misura?: number;
  class?: string;
}

const TRATTI = {
  luogo:
    '<path d="M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0c0 5.2-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.2" cy="6.8" r="0.6"/>',
  whatsapp:
    '<path d="M12 3.5a8.5 8.5 0 0 0-7.4 12.7L3.5 20.5l4.4-1.1A8.5 8.5 0 1 0 12 3.5z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>',
  telefono:
    '<path d="M6.6 3.5h2.6l1.4 4-1.9 1.3a10.5 10.5 0 0 0 6.5 6.5l1.3-1.9 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z"/>',
  menu: '<path d="M4 8.5h16M4 15.5h16"/>',
  chiudi: '<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>',
  freccia: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  prec: '<path d="M14.5 5.5L8 12l6.5 6.5"/>',
  succ: '<path d="M9.5 5.5L16 12l-6.5 6.5"/>',
  giu: '<path d="M5.5 9.5L12 16l6.5-6.5"/>',
  orologio: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  info: '<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5M12 7.8v.2"/>',
  griglia:
    '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9.3 4v16M14.7 4v16M4 9.3h16M4 14.7h16"/>',
  multi:
    '<rect x="8" y="3.5" width="12.5" height="12.5" rx="2.5"/><path d="M16 20.5H6a2.5 2.5 0 0 1-2.5-2.5V8"/>',
  pausa: '<path d="M9 6v12M15 6v12"/>',
  riproduci: '<path d="M8 5.5v13l10.5-6.5z"/>',
  stella:
    '<path d="M12 3.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z"/>',
} as const;

const { nome, misura = 20, class: classe } = Astro.props;
// La stella è piena; l'icona delle foto multiple ha il tratto un po' più spesso.
const piena = nome === 'stella';
---

<svg
  aria-hidden="true"
  focusable="false"
  class={classe}
  width={misura}
  height={misura}
  viewBox="0 0 24 24"
  fill={piena ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={piena ? 1 : nome === 'multi' ? 1.8 : 1.6}
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={TRATTI[nome]}
/>
