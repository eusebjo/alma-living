---
// Variante di prova "Salvia social" (versione 3, tavola DiarioFascia.dc.html, con
// l'apertura "La foto grande" della tavola FotoGrande2.dc.html): bianco e verde
// salvia, storie sotto l'header solo sul telefono, apertura con le foto dei
// prodotti che scorrono da sole, selezione, diario del negozio con griglia di post
// e fascia Instagram.
// Componenti e dati fissi in src/sito/componenti/; prodotti, post e storie dalle
// collection (src/content/), tradotti per i componenti da src/sito/contenuti.ts.
import { getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Interazioni from '../../../sito/comune/Interazioni.astro';
import LayoutProva from '../../../sito/comune/LayoutProva.astro';
import { CARATTERI_PER_VARIANTE } from '../../../sito/comune/caratteri';
import grana from '../../../sito/comune/grana.png';
import { datiNegozio } from '../../../sito/comune/negozio';
import Apertura from '../../../sito/componenti/Apertura.astro';
import BarraTelefono from '../../../sito/componenti/BarraTelefono.astro';
import DialogStorie from '../../../sito/componenti/DialogStorie.astro';
import Diario from '../../../sito/componenti/Diario.astro';
import FasciaInstagram from '../../../sito/componenti/FasciaInstagram.astro';
import FilaStorie from '../../../sito/componenti/FilaStorie.astro';
import Negozio from '../../../sito/componenti/Negozio.astro';
import Piede from '../../../sito/componenti/Piede.astro';
import Selezione from '../../../sito/componenti/Selezione.astro';
import Testata from '../../../sito/componenti/Testata.astro';
import '../../../sito/componenti/tema.css';
import { elencoArticoli, elencoPost, elencoStorie } from '../../../sito/contenuti';

const voce = await getEntry('negozio', 'negozio');
if (!voce) throw new Error('Manca src/content/negozio/negozio.json (voce "negozio").');
const negozio = datiNegozio(voce.data);

const articoli = elencoArticoli(await getCollection('prodotti'));
const post = elencoPost(await getCollection('post'));
const storie = elencoStorie(await getCollection('storie'));

// La grana delle fasce salvia, come sulla tavola: una tessera ripetuta in CSS.
const tessera = await getImage({ src: grana, format: 'webp', quality: 40 });
---

<LayoutProva
  title="Salvia social | Alma Living, prova di design"
  description="Variante di prova del sito di Alma Living: bianco e verde salvia, storie dal negozio, la selezione e il diario del negozio."
  caratteri={CARATTERI_PER_VARIANTE['salvia-social']}
  variante="salvia-social"
>
  <div class="pagina" id="inizio" style={`--grana: url('${tessera.src}')`}>
    <Testata negozio={negozio} />
    <FilaStorie storie={storie} />
    <main>
      <Apertura />
      <Selezione articoli={articoli} negozio={negozio} />
      <Diario post={post} negozio={negozio} />
      <FasciaInstagram negozio={negozio} />
      <Negozio negozio={negozio} />
    </main>
    <Piede negozio={negozio} />
    <BarraTelefono negozio={negozio} />
  </div>

  <DialogStorie storie={storie} etichetta="Storie dal negozio" negozio={negozio} />
  <Interazioni />
</LayoutProva>

<style>
  /* `clip` e non `hidden`: le decorazioni che sbordano non allargano la pagina
     e l'header resta `sticky`. */
  .pagina {
    position: relative;
    overflow-x: clip;
  }
</style>
